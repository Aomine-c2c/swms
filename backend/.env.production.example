# Smart-Weigh Production Environment Variables
# Copy this file to .env and configure the variables for your production environment

# Django Security
SECRET_KEY=your-super-secret-key-here-do-not-share
DEBUG=False

# Hosts and Security (comma separated)
ALLOWED_HOSTS=api.yourdomain.com,localhost
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,tauri://localhost

# If set to True, Django will enforce HTTPS redirects, secure cookies, and HSTS
SECURE_PROTOCOLS=True

# Database Configuration (MySQL Recommended for Production)
# Format: mysql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=mysql://smartweigh_user:your-db-password@localhost:3306/smart_weigh

# Backup Configuration
BACKUP_DIR=/var/backups/smart_weigh
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# Optional paths for backup engine if they are not in system PATH
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
