{
  "name": "smart-weigh-system",
  "version": "1.0.0",
  "description": "Smart-Weigh Management System",
  "scripts": {
    "dev:frontend": "node scripts/run-frontend.js",
    "dev:backend": "node scripts/run-backend.js",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:all": "bash run-all.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
